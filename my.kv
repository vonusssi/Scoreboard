ScreenManager:

    MainScreen:
    EverScreen:
    PaganScreen:
    WondersScreen:


<ScoreLabel@Label>:
    font_size: "64sp"
    bold: True
    halign: "center"
    valign: "middle"
    text_size: self.size
    padding: dp(8), dp(8)
    canvas.before:
        Color:
            rgba: 0.08, 0.12, 0.20, 0.96
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18), dp(18), dp(18), dp(18)]

<StreakLabel@Label>:
    font_size: "16sp"
    size_hint: 0.25, 0.05
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: 0.08, 0.12, 0.20, 0.96
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18), dp(18), dp(18), dp(18)]
<LastWinLabel@Label>:
    font_size: "12sp"
    size_hint: 0.4, 0.05
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: 0.08, 0.12, 0.20, 0.96
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18), dp(18), dp(18), dp(18)]
<PlusButton@Button>:
    text: "+"
    font_size: "30sp"
    size_hint: 0.1, 0.05
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: 0.08, 0.12, 0.20, 0.96
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18), dp(18), dp(18), dp(18)]
    
<MinusButton@Button>:
    text: "-"
    font_size: "30sp"
    size_hint: 0.1, 0.05
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: 0.08, 0.12, 0.20, 0.96
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18), dp(18), dp(18), dp(18)]

<MainScreen@Screen>:
    name: "main"

    GridLayout:
        cols: 3
        spacing: 5
        padding: 5

        ImageButton:
            source: "everdell2.jpg"
            allow_stretch: True
            keep_ratio: True
            on_press: app.image_clicked("ever")

        ImageButton:
            source: "pagan.png"
            allow_stretch: True
            keep_ratio: True
            on_press: app.image_clicked("pagan")

        ImageButton:
            source: "sevenwonders.webp"
            allow_stretch: True
            keep_ratio: True
            on_press: app.image_clicked("wonders")

        Button:
            text: "Create Profile"
            on_press: app.show_input()
        Button:
            text: "Load Profile"
            on_press: app.show_profiles(mode="load")
        Button:
            text: "Delete Profile"
            on_press: app.show_profiles(mode="delete")
<EverScreen@Screen>:
    name: "ever"

    FloatLayout: 
        canvas.before:
            Color:
                rgba: 0.45, 0.37, 0.24, 1.0
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "Everdell: " + app.current_profile
            font_size: "32sp"
            font_name: "fonts/Medieval.ttf"
            color: 1.0, 0.9019607843137255, 0.6549019607843137, 1.0
            pos_hint: {"center_x":0.5,"top":1}
            size_hint: 1, 0.3
            canvas.before:
                Color:
                    rgba: 0.2196078431372549, 0.4, 0.2549019607843137, 1.0
                Rectangle:
                    pos: self.pos
                    size: self.size

        ScoreLabel:
            text: str(app.scores["ever"][0][0])
            color: 0.25, 0.65, 1, 1
            pos_hint: {"center_x":0.255,"top":0.67}
            size_hint: 0.3, 0.2
        ScoreLabel:
            text: str(app.scores["ever"][0][1])
            color: 1, 0.55, 0.2, 1
            pos_hint: {"center_x":0.745,"top":0.67}
            size_hint: 0.3, 0.2
        LastWinLabel: 
            text: "Last Win: " + app.scores["ever"][1][0]
            pos_hint: {"center_x":0.255,"top":0.3}
        LastWinLabel: 
            text: "Last Win: " + app.scores["ever"][1][1]
            pos_hint: {"center_x":0.745,"top":0.3}
        StreakLabel: 
            text: "Streak: " + str(app.scores["ever"][2][0])
            pos_hint: {"center_x":0.255,"top":0.375}
        StreakLabel: 
            text: "Streak: " + str(app.scores["ever"][2][1])
            pos_hint: {"center_x":0.745,"top":0.375}

        Button:
            text: "Back"
            font_size: "48sp"
            font_name: "fonts/Medieval.ttf"
            color: 1.0, 0.9019607843137255, 0.6549019607843137, 1.0
            background_normal: ""
            background_down: ""
            background_color: 0.2196078431372549, 0.4, 0.2549019607843137, 1.0
            on_press: app.root.current = "main"
            pos_hint: {"center_x":0.5,"top":0.2}
            size_hint: 0.4, 0.1
        PlusButton:
            on_press: app.change_score("ever",0,1)
            pos_hint: {"center_x":0.17,"top":0.45}
        MinusButton:
            on_press: app.change_score("ever",0,-1)
            pos_hint: {"center_x":0.34,"top":0.45}

        PlusButton:
            on_press: app.change_score("ever",1,1)
            pos_hint: {"center_x":0.66,"top":0.45}
        MinusButton:
            on_press: app.change_score("ever",1,-1)
            pos_hint: {"center_x":0.83,"top":0.45}
            


<PaganScreen@Screen>:
    name: "pagan"

    FloatLayout:
        
        Label: 
            text: "Last Win: " + app.scores["pagan"][1][0]
            pos_hint: {"center_x":0.255,"top":0.35}
            size_hint: 0.2, 0.1
        Label: 
            text: "Last Win: " + app.scores["pagan"][1][1]
            pos_hint: {"center_x":0.745,"top":0.35}
            size_hint: 0.2, 0.1
        Label: 
            text: "Streak: " + str(app.scores["pagan"][2][0])
            pos_hint: {"center_x":0.255,"top":0.4}
            size_hint: 0.2, 0.1
        Label: 
            text: "Streak: " + str(app.scores["pagan"][2][1])
            pos_hint: {"center_x":0.745,"top":0.4}
            size_hint: 0.2, 0.1

        Label:
            text: "Pagan: " + app.current_profile
            pos_hint: {"center_x":0.5,"top":1}
            size_hint: 1, 0.15
            canvas.before:
                Color:
                    rgba: 0.2, 0.6, 0.9, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
        ScoreLabel:
            text: str(app.scores["pagan"][0][0])
            color: 0.25, 0.65, 1, 1
            pos_hint: {"center_x":0.255,"top":0.67}
            size_hint: 0.3, 0.2
        ScoreLabel:
            text: str(app.scores["pagan"][0][1])
            color: 1, 0.55, 0.2, 1
            pos_hint: {"center_x":0.745,"top":0.67}
            size_hint: 0.3, 0.2
        Button:
            text: "Back"
            on_press: app.root.current = "main"
            pos_hint: {"center_x":0.5,"top":0.2}
            size_hint: 0.6, 0.15
        PlusButton:
            on_press: app.change_score("pagan",0,1)
            pos_hint: {"center_x":0.225,"top":0.45}
        MinusButton:
            on_press: app.change_score("pagan",0,-1)
            pos_hint: {"center_x":0.285,"top":0.45}
        PlusButton:
            on_press: app.change_score("pagan",1,1)
            pos_hint: {"center_x":0.715,"top":0.45}
        MinusButton:
            on_press: app.change_score("pagan",1,-1)
            pos_hint: {"center_x":0.775,"top":0.45}
        

<WondersScreen@Screen>
    name: "wonders"
    
    
    FloatLayout:

        canvas.before:
            Color:
                rgba: 0.6, 0.4, 0.2, 0.85
            Rectangle: 
                pos: self.pos
                size: self.size

        Label:
            text: "Seven Wonders: " + app.current_profile
            pos_hint: {"center_x":0.5,"top":1}
            size_hint: 0.6, 0.15
            canvas.before:
                Color:
                    rgba: 0.01, 0.3, 0.01, 0.85
                Rectangle:
                    pos: self.pos
                    size: self.size
       
        ScoreLabel:
            text: str(app.scores["wonders"][0][0])
            color: 0.25, 0.65, 1, 1
            pos_hint: {"center_x":0.255,"top":0.67}
            size_hint: 0.3, 0.2
        ScoreLabel:
            text: str(app.scores["wonders"][0][1])
            color: 1, 0.55, 0.2, 1
            pos_hint: {"center_x":0.745,"top":0.67}
            size_hint: 0.3, 0.2

        Label: 
            text: "Last Win: " + app.scores["wonders"][1][0]
            pos_hint: {"center_x":0.255,"top":0.35}
            size_hint: 0.2, 0.1
        Label: 
            text: "Last Win: " + app.scores["wonders"][1][1]
            pos_hint: {"center_x":0.745,"top":0.35}
            size_hint: 0.2, 0.1
        Label: 
            text: "Streak: " + str(app.scores["wonders"][2][0])
            pos_hint: {"center_x":0.255,"top":0.4}
            size_hint: 0.2, 0.1
        Label: 
            text: "Streak: " + str(app.scores["wonders"][2][1])
            pos_hint: {"center_x":0.745,"top":0.4}
            size_hint: 0.2, 0.1

        Button:
            text: "Back"
